generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model Trayecto {
  id            String   @id @db.VarChar(36)
  origen        String   @db.Text
  destino       String   @db.Text
  hora          DateTime
  plazas        Int
  disponible    Int
  precio        Float
  conductor     String   @db.VarChar(36)
  routeIndex    Int?     @default(0)
  status        String   @default("programado") @db.VarChar(20)
  origen_lat    Float?
  origen_lng    Float?
  destino_lat   Float?
  destino_lng   Float?
  notified_15min Int     @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now()) @updatedAt

  Reservas      Reserva[]

  @@index([origen_lat, origen_lng], name: "idx_trayectos_origen")
  @@index([destino_lat, destino_lng], name: "idx_trayectos_destino")
  @@index([hora], name: "idx_trayectos_hora")
  @@index([conductor], name: "idx_trayectos_conductor")

  @@map("trayectos")
}

model Reserva {
  id_reserva                    String   @id @db.VarChar(36)
  user_id                       String   @db.VarChar(36)
  id_trayecto                   String   @db.VarChar(36)
  status                        String   @default("pending") @db.VarChar(20)
  stripe_checkout_session_id    String?  @db.VarChar(255)
  stripe_payment_intent_id      String?  @db.VarChar(255)
  stripe_payment_intent_status  String?  @db.VarChar(50)
  trip_outcome                  String   @default("pending") @db.VarChar(20)
  trip_outcome_reason           String?  @db.Text
  trip_outcome_at               DateTime?
  created_at                    DateTime @default(now())
  updated_at                    DateTime @default(now()) @updatedAt

  Trayecto                      Trayecto @relation(fields: [id_trayecto], references: [id])

  @@unique([user_id, id_trayecto])
  @@index([id_trayecto], name: "idx_reservas_trayecto")
  @@index([stripe_checkout_session_id], name: "idx_reservas_stripe_checkout")

  @@map("reservas")
}

model Comment {
  id_comment          String   @id @db.VarChar(36)
  user_id_commentator String   @db.VarChar(36)
  user_id_trayect     String   @db.VarChar(36)
  id_trayecto         String   @db.VarChar(36)
  opinion             String?  @db.Text
  rating              Int?
  created_at          DateTime @default(now())
  updated_at          DateTime @default(now()) @updatedAt

  @@unique([user_id_commentator, id_trayecto])
  @@index([id_trayecto], name: "idx_comments_trayecto")
  @@index([user_id_commentator], name: "idx_comments_commentator")

  @@map("comments")
}

model Ubicacion {
  id           String   @id @db.VarChar(36)
  lat          Float
  lng          Float
  display_name String   @db.Text
  address      String   @db.VarChar(255)
  city         String?  @db.Text
  province     String?  @db.Text
  country      String?  @db.Text
  postal_code  String?  @db.Text
  type         String?  @db.Text
  user_id      String   @db.VarChar(36)
  created_at   DateTime @default(now())
  updated_at   DateTime @default(now()) @updatedAt

  @@unique([user_id, address])
  @@index([user_id], name: "idx_ubicaciones_user_id")

  @@map("ubicaciones")
}

model FrequentRoute {
  id            String   @id @db.VarChar(36)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @default(now())
  user_id       String   @db.VarChar(36)
  name          String?  @db.Text
  originAddress String   @db.Text
  originLat     Float
  originLng     Float
  destAddress   String   @db.Text
  destLat       Float
  destLng       Float
  role          String   @default("DRIVER") @db.VarChar(20)
  seats         Int      @default(1)

  @@index([user_id], name: "idx_frequents_routes_user_id")

  @@map("frequents_routes")
}

model PreferenceDefinition {
  pref_key      String   @id @db.VarChar(100)
  value_type    String   @db.VarChar(20)
  default_value String   @db.Text
  enum_values   String?  @db.Text
  description   String?  @db.Text
  is_active     Int      @default(1)

  @@map("preference_definitions")
}

model UserPreference {
  user_id    String   @db.VarChar(36)
  pref_key   String   @db.VarChar(100)
  value      String   @db.Text
  updated_at DateTime @default(now())

  @@id([user_id, pref_key])
  @@index([user_id], name: "idx_user_preferences_user_id")
  @@index([pref_key], name: "idx_user_preferences_pref_key")

  @@map("user_preferences")
}

model Pago {
  id                          Int      @id @default(autoincrement())
  stripe_checkout_session_id  String?  @db.VarChar(255)
  stripe_payment_intent_id    String?  @db.VarChar(255)
  payment_status              String?  @db.VarChar(50)
  amount                      Int?
  currency                    String?  @db.VarChar(10)
  user_id                     String?  @db.VarChar(36)
  id_trayecto                 String?  @db.VarChar(36)
  stripe_event_id             String?  @db.Text
  created_at                  DateTime @default(now())

  @@index([stripe_checkout_session_id], name: "idx_pagos_checkout_session")
  @@index([stripe_payment_intent_id], name: "idx_pagos_payment_intent")

  @@map("pagos")
}

model Recorrido {
  id          String   @id @db.VarChar(36)
  id_trayecto String   @db.VarChar(36)
  user_id     String   @db.VarChar(36)
  lat         Float
  lng         Float
  address     String   @db.Text
  created_at  DateTime @default(now())

  @@index([id_trayecto], name: "idx_recorridos_trayecto")
  @@index([user_id], name: "idx_recorridos_user_id")
  @@index([id_trayecto, user_id], name: "idx_recorridos_trayecto_user")

  @@map("recorridos")
}
