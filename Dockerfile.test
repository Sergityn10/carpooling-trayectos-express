# Dockerfile para el runner de tests
FROM node:22-alpine AS test-runner

WORKDIR /app

# Instalar dependencias del sistema necesarias para wait-on y Prisma
RUN apk add --no-cache openssl curl

# Copiar package.json y lock
COPY package*.json ./

# Instalar TODAS las dependencias (incluidas devDependencies)
RUN npm ci

# Copiar schema de Prisma
COPY prisma ./prisma

# Generar cliente Prisma
RUN npx prisma generate

# Instalar wait-on globalmente para healthcheck de BD
RUN npm install -g wait-on

# Copiar código de la aplicación
COPY . .

# Crear usuario no-root para seguridad
RUN addgroup -g 1001 -S nodejs && \
    adduser -S nodejs -u 1001

# Cambiar propietario de archivos
RUN chown -R nodejs:nodejs /app

USER nodejs

# Comando por defecto (se sobrescribe en docker-compose)
CMD ["npm", "run", "test:all"]